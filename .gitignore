# 注意不带斜杠：demo/node_modules 是指向工作区外的软链，带斜杠匹配不到
node_modules
.pnpm-store/
.DS_Store

# WorkBuddy 本地数据目录（记忆、日志、会话状态）
.workbuddy/

# 上游项目 nexu-io/html-video 是独立 clone，自带 .git，不纳入本仓库
# 获取方式见 README「上游项目」一节
html-video/

# ---------------------------------------------------------------
# 仓库只存「制作流程」：脚本 + 帧 HTML + 分镜/文案 JSON + 文档。
# 一切渲染产物不入库，都能由源码重跑得到。
# ---------------------------------------------------------------

# 渲染输出目录（分片、静帧、成片、缓存 meta）
# demo/out/ 下 3 个早期 mp4 是历史 tracked 文件，忽略规则不追溯
demo/out*/

# 媒体产物：成片 / 中间片 / TTS 语音 / 程序合成 BGM / 字幕
demo/**/*.mp4
demo/**/*.webm
demo/**/*.wav
demo/**/*.mp3
demo/**/*.m4a
demo/**/*.srt

# 抽帧验布局产生的截图
demo/**/shot*.png

# 合规相关的废弃帧：内容是「谐音替身 / 哔声」等规避手法，只留本地
demo/**/_removed/

# 依赖安装残留
*.log
